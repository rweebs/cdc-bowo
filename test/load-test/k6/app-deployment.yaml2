apiVersion: v1
kind: Pod
metadata:
  name: k6
spec:
  containers:
    - name: app
      image: grafana/k6
      command: ["run"]
      args:
        - "/script/script.js --vus 1 --duration 10m --rps 3 -v"
      volumeMounts:
        - name: app-config
          mountPath: /script
  volumes:
    - name: app-config
      configMap:
        name: app-config