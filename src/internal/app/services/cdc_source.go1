package services

import (
	"context"
	"encoding/json"
	"fmt"
	"io/ioutil"
	"strconv"
	"sync"
	"time"

	"github.com/go-redis/redis/v8"
	"github.com/lib/pq"
	"github.com/rweebs/cdc-bowo/internal/app/config"
	"github.com/rweebs/cdc-bowo/internal/app/lib"
	"github.com/rweebs/cdc-bowo/internal/app/model"
	"github.com/rweebs/cdc-bowo/internal/app/utils"
)

type CDCSourceServices struct {
	dbSource           lib.Database
	dbDest             lib.Database
	rdb                lib.Cache
	primaryKeyList     map[string][]string
	RedisStreamList    map[string]string
	transformationList map[string]config.DDLTransform
	config             config.Config
}

func (s *CDCSourceServices) ExecuteDDLChange() {
	log.Println("Execute DDL Change")
	sqlFile, err := ioutil.ReadFile(s.config.SQLFile)
	if err != nil {
		log.Println(err)
	}
	sql := string(sqlFile)
	_, err = utils.SQLExecutor(s.dbDest.Db, sql)
	if err != nil {
		log.Println(err)
		panic("Error Execute DDL Change")
	}

	// statements := strings.Split(sql, ";")
	// for _, statement := range statements {
	// 	_, err = utils.SQLExecutor(s.dbDest.Db, statement)
	// 	if err != nil {
	// 		log.Println(err)
	// 	}
	// }
	log.Println("Execute DDL Change Done")
}
func (s *CDCSourceServices) StartService(startTimestamp int64) {
	mainContext := context.Background()

	wg := sync.WaitGroup{}

	var mu sync.Mutex
	// Start a goroutine for each Redis stream
	for stream, value := range s.RedisStreamList {
		wg.Add(1)

		go func(stream []string) {
			defer func() {
				mu.Lock()
				s.RedisStreamList[stream[0]] = stream[1]
				mu.Unlock()
				wg.Done()
			}()

			for {
				val, _ := s.GetTimeStampCutOff()
				ctx, _ := context.WithTimeout(mainContext, 1*time.Second)
				entries, _ := s.rdb.Cache.XRead(ctx, &redis.XReadArgs{
					Streams: []string{stream[0], stream[1]},
					Count:   1000,
					Block:   0,
				}).Result()

				// if err != nil {
				// 	fmt.Printf("Error reading stream %s: %s\n", stream, err)
				// 	return
				// }

				if val > 0 && len(entries) == 0 {
					return
				}

				for _, streamEntries := range entries {
					for _, entry := range streamEntries.Messages {
						log.Println("Received event from stream", streamEntries.Stream)

						for _, v := range entry.Values {
							var sql string
							var dat model.AutoGenerated
							if err := json.Unmarshal([]byte(fmt.Sprintf("%v", v)), &dat); err != nil {
								continue
							}

							if dat.Payload.TsMs < startTimestamp {
								continue
							}

							if val, ok := s.transformationList[fmt.Sprintf("%s.%s", dat.Payload.Source.Schema, dat.Payload.Source.Table)]; ok {
								dat = utils.ConvertSchema(dat, val)
								sql = utils.ConvertDataToSQL(dat, s.primaryKeyList, val, true, s.dbSource.Db)
							} else {
								sql = utils.ConvertDataToSQL(dat, s.primaryKeyList, config.DDLTransform{}, true, s.dbSource.Db)
							}

							for {
								_, err := utils.SQLExecutor(s.dbDest.Db, sql)
								if err != nil {
									fmt.Printf("error %s \n error code %s \n", err, err.(*pq.Error).Code)
									if err.(*pq.Error).Code == "23505" {
										// Pause the execution of the goroutine by waiting for a short duration
										time.Sleep(100 * time.Millisecond)
										// Retry the SQL execution
										continue
									} else {
										// Exit the loop if the error code is not 23505
										break
									}
								} else {
									// SQL execution succeeded, exit the loop
									break
								}
							}
						}
						// Acquire the mutex before modifying the shared map
						// mu.Lock()
						stream[1] = entry.ID
						// Release the mutex after modifying the shared map
						// mu.Unlock()
					}
				}
			}
		}([]string{stream, value})
	}

	// Wait for all goroutines to complete
	wg.Wait()
}

func (s *CDCSourceServices) StopService() {
	data, _ := json.Marshal(s.RedisStreamList)
	s.rdb.Cache.Set(context.Background(), "sourceRedisStreamList", data, 0)
	log.Println("Stop Source Service")
}

func (s *CDCSourceServices) GetTimeStampCutOff() (int64, error) {
	res, err := s.rdb.Cache.Get(context.Background(), "cdc-source-stop-timestamp").Result()
	if err != nil {
		return 0, err
	}
	result, err := strconv.ParseInt(res, 10, 64)
	return result, err
}

func NewCDCSourceServices(dbSource lib.Database, dbDest lib.Database, rdb lib.Cache, config config.Config) *CDCSourceServices {
	sqlFile, err := ioutil.ReadFile(config.SQLFile)
	if err != nil {
		panic(`Error reading SQL file`)
	}
	return &CDCSourceServices{
		dbSource:           dbSource,
		dbDest:             dbDest,
		rdb:                rdb,
		primaryKeyList:     initPrimaryKeyList(dbSource.Db),
		RedisStreamList:    initRedisStreamList(dbSource.Db, rdb.Cache, "sourceRedisStreamList", config.SourceConfig.DebeziumPublication, config.SourceConfig.RedisTopicPrefix),
		config:             config,
		transformationList: utils.InitTransformListNew(string(sqlFile), config.DDLTransform),
	}
}

func (s *CDCSourceServices) checkReplicationCatchUp() (bool, error) {
	var different_lsn int64
	err := s.dbSource.Db.QueryRow("SELECT pg_current_wal_lsn()-replay_lsn FROM pg_stat_replication where application_name=$1;", s.config.DestConfig.SubscriptionName).Scan(&different_lsn)
	if err != nil {
		return true, nil
	}

	return different_lsn < 100, nil
}

func (s *CDCSourceServices) dropDestSubscription() error {
	_, err := s.dbDest.Db.Exec("DROP SUBSCRIPTION IF EXISTS " + s.config.DestConfig.SubscriptionName + ";")
	return err
}

func (s *CDCSourceServices) checkStopReplicationReady() bool {
	res, err := s.rdb.Cache.Get(context.Background(), "stop-replication-ready").Result()
	if err != nil {
		return false
	}
	result, err := strconv.ParseInt(res, 10, 64)
	if err != nil {
		return false
	}
	log.Println(result)
	return result == 1
}

func (s *CDCSourceServices) StopReplication() (int64, error) {
	for !s.checkStopReplicationReady() {
		log.Println("Waiting to start application")
		time.Sleep(100 * time.Millisecond)
	}
	log.Println("Proceed to stop replication waiting for replication catch up")
	for result, err := s.checkReplicationCatchUp(); err != nil || !result; result, err = s.checkReplicationCatchUp() {
		time.Sleep(100 * time.Millisecond)
		log.Println("Waiting for replication catch up")
	}
	log.Println("Replication catch up, start to drop subscription")
	timestamp := time.Now().UnixNano() / int64(time.Millisecond)
	s.rdb.Cache.Set(context.Background(), "stop-replication-timestamp", timestamp, 0)
	err := s.dropDestSubscription()

	return timestamp, err
}
