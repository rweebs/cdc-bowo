func TestModifyTemporalDataType(t *testing.T) {
	var tests = []struct {
		testName   string
		dataString string
		expected   string
	}{
		{
			testName:   "Test Modify Temporal Data Type Insert Timestamp to Timestamp",
			dataString: ``,
			expected:   ``,
		},
		{
			testName:   "Test Modify Temporal Data Type Delete Timestamp to Timestamp",
			dataString: ``,
			expected:   ``,
		},
		{
			testName:   "Test Modify Temporal Data Type Insert Timestamp to Date",
			dataString: ``,
			expected:   ``,
		},
		{
			testName:   "Test Modify Temporal Data Type Delete Timestamp to Date",
			dataString: ``,
			expected:   ``,
		},
		{
			testName:   "Test Modify Temporal Data Type Insert Date to Timestamp",
			dataString: ``,
			expected:   ``,
		},
		{
			testName:   "Test Modify Temporal Data Type Delete Date to Timestamp",
			dataString: ``,
			expected:   ``,
		},
		{
			testName:   "Test Modify Temporal Data Type Insert Date to Date",
			dataString: ``,
			expected:   ``,
		},
		{
			testName:   "Test Modify Temporal Data Type Delete Date to Date",
			dataString: ``,
			expected:   ``,
		},
	}

	for _, tt := range tests {
		t.Run(tt.testName, func(t *testing.T) {

			if tt.dataString != tt.expected {
				t.Errorf("got %s, want %s", tt.dataString, tt.expected)
			}
		})
	}
}
func TestModifyDataType(t *testing.T) {
	var tests = []struct {
		testName   string
		dataString string
		expected   string
	}{
		{
			testName: "Test Modify Temporal Data Insert Type time (3) to time, timestamp (3) to timestamp, timestamp to timestamp with timezone and rename column and modify datatype at the same time",
			// Alter table public.test_temporal rename column time_mili to time2; Alter table public.test_temporal rename column timestamp_mili to timestamp2; Alter table public.test_temporal rename column timestamp to timestamp_with_time_zone2; Alter table  public.test_temporal alter column time2 type time; Alter table  public.test_temporal alter column timestamp2 type timestamp; Alter table  public.test_temporal alter column timestamp_with_time_zone2 type timestamp with time zone;
			dataString: `{"schema":{"type":"struct","fields":[{"type":"struct","fields":[{"type":"int32","optional":false,"default":0,"field":"id"},{"type":"int64","optional":true,"default":0,"name":"io.debezium.time.MicroTime","field":"time"},{"type":"int32","optional":true,"default":0,"name":"io.debezium.time.Time","field":"time_mili"},{"type":"string","optional":true,"name":"io.debezium.time.ZonedTime","field":"time_with_time_zone"},{"type":"int64","optional":true,"default":0,"name":"io.debezium.time.MicroTimestamp","field":"timestamp"},{"type":"int64","optional":true,"default":0,"name":"io.debezium.time.Timestamp","field":"timestamp_mili"},{"type":"string","optional":true,"default":"1970-01-01T00:00:00Z","name":"io.debezium.time.ZonedTimestamp","field":"timestamp_with_time_zone"},{"type":"int32","optional":true,"default":0,"name":"io.debezium.time.Date","field":"date"}],"optional":true,"name":"test2.public.test_temporal.Value","field":"before"},{"type":"struct","fields":[{"type":"int32","optional":false,"default":0,"field":"id"},{"type":"int64","optional":true,"default":0,"name":"io.debezium.time.MicroTime","field":"time"},{"type":"int32","optional":true,"default":0,"name":"io.debezium.time.Time","field":"time_mili"},{"type":"string","optional":true,"name":"io.debezium.time.ZonedTime","field":"time_with_time_zone"},{"type":"int64","optional":true,"default":0,"name":"io.debezium.time.MicroTimestamp","field":"timestamp"},{"type":"int64","optional":true,"default":0,"name":"io.debezium.time.Timestamp","field":"timestamp_mili"},{"type":"string","optional":true,"default":"1970-01-01T00:00:00Z","name":"io.debezium.time.ZonedTimestamp","field":"timestamp_with_time_zone"},{"type":"int32","optional":true,"default":0,"name":"io.debezium.time.Date","field":"date"}],"optional":true,"name":"test2.public.test_temporal.Value","field":"after"},{"type":"struct","fields":[{"type":"string","optional":false,"field":"version"},{"type":"string","optional":false,"field":"connector"},{"type":"string","optional":false,"field":"name"},{"type":"int64","optional":false,"field":"ts_ms"},{"type":"string","optional":true,"default":"false","name":"io.debezium.data.Enum","field":"snapshot"},{"type":"string","optional":false,"field":"db"},{"type":"string","optional":true,"field":"sequence"},{"type":"string","optional":false,"field":"schema"},{"type":"string","optional":false,"field":"table"},{"type":"int64","optional":true,"field":"txId"},{"type":"int64","optional":true,"field":"lsn"},{"type":"int64","optional":true,"field":"xmin"}],"optional":false,"name":"io.debezium.connector.postgresql.Source","field":"source"},{"type":"string","optional":false,"field":"op"},{"type":"int64","optional":true,"field":"ts_ms"},{"type":"struct","fields":[{"type":"string","optional":false,"field":"id"},{"type":"int64","optional":false,"field":"total_order"},{"type":"int64","optional":false,"field":"data_collection_order"}],"optional":true,"name":"event.block","field":"transaction","version":1}],"optional":false,"name":"test2.public.test_temporal.Envelope","version":1},"payload":{"before":null,"after":{"date":19398,"id":45,"time":26482798069,"time_mili":26482798,"time_with_time_zone":"02:47:09.863519Z","timestamp":1676013682798069,"timestamp_mili":1676013682798,"timestamp_with_time_zone":"2023-02-10T07:21:22.798069Z"},"source":{"version":"2.1.2.Final","connector":"postgresql","name":"test2","ts_ms":1676013682806,"snapshot":"false","db":"ta1","sequence":"[\"498311048\",\"498311464\"]","schema":"public","table":"test_temporal","txId":775260,"lsn":498311464,"xmin":null},"op":"c","ts_ms":1676013682942,"transaction":null}}`,
			expected:   `INSERT INTO public.test_temporal (date,timestamp2,timestamp_with_time_zone2,time,time_with_time_zone,timestamp_with_time_zone,time2,id) VALUES ('2023-02-10','2023-02-10T07:21:22.798Z'::timestamp,'2023-02-10T07:21:22.798069Z'::timestamptz,'07:21:22.798069','02:47:09.863519Z','2023-02-10T07:21:22.798069Z','07:21:22.798000'::time,45);`,
		},
	}

	for _, tt := range tests {
		t.Run(tt.testName, func(t *testing.T) {
			var dat model.AutoGenerated
			err := json.Unmarshal([]byte(tt.dataString), &dat)
			if err != nil {
				log.Println(err)
				t.Errorf("Error unmarshal data")
			}
			sql, _ := ConvertDataToSQLTest(map[string][]string{}, dat, true)
			if SortStringByCharacter(sql) != SortStringByCharacter(tt.expected) {
				t.Errorf("got %s, want %s", sql, tt.expected)
			}
		})
	}
}
