# Kubernetes API version
apiVersion: batch/v1
kind: Job
metadata:
  # The name of the Deployment
  name: postgresdb
spec:
  # Replicas for this Deployment
  parallelism: 1    
  completions: 1 
  template:
    metadata:
      labels:
        # The label the pods created from the pod template should have
        app: postgresdb
    spec:
      containers:
        # The container name to execute pods
        - name: postgresdb
          # pull postgresimage from docker hub
          image: postgres:14.7
          volumeMounts:
            - name: insert
              mountPath: /scripts/insert
            - name: update
              mountPath: /scripts/update
            - name: delete
              mountPath: /scripts/delete
            - name: test-script
              mountPath /scripts/test
          ports:
            # Assign ports to expose container
            - containerPort: 5432
          env:
            - name: PGHOST
              value: ${source_host}
            - name: PGUSER
              value: postgres
            - name: PGDATABASE
              value: postgres
            - name: PGPASSWORD
              value: ${source_password}
            - name: POSTGRES_PASSWORD
              value: password 
        command:
        - /bin/sh
        - -c
        - |

          pg_dump -t transaction_delete_primary > primary.sql
          psql -f primary.sql
          psql -c 'INSERT INTO transaction_unified (id, message, created, created_cdc, rps, op) SELECT s.id,s.message, p.created, s.created_cdc, s.rps, s.op FROM transaction_delete AS s JOIN transaction_delete_primary AS p ON s.id = p.id;'
          psql -c 'ALTER TABLE transaction_unified ADD COLUMN replication_lag interval;'
          psql -c 'UPDATE transaction_unified set replication_lag=(created_cdc - created);'
      restartPolicy: Never
      volumes:
        - name: insert
          configMap:
            name: insert
        - name: update
          configMap:
            name: update
        - name: delete
          configMap:
            name: delete
        - name: test
          configMap:
            name: test-script
