apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${app_label}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ${app_label}
  template:
    metadata:
      labels:
        app: ${app_label}
        tier: backend
    spec:
      containers:
        - name: app
          image: ${app_image}
          imagePullPolicy: Always
          volumeMounts:
            - name: ${app_config}
              mountPath: /config
      volumes:
        - name: app-config
          configMap:
            name: ${app_config}